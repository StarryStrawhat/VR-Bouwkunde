}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a0f9de8ed71644f7ac4c48d79e301888",
    "m_Title": "",
    "m_Content": "First, we isolate just the height data - the Y channel of the position.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -5134.0,
        "y": 337.0,
        "width": 200.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "99ab2e30bee74d358b578946bd1a9c0c"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a114ffcd15984df09ffd4daa5af794f6",
    "m_Title": "",
    "m_Content": "Here we take the Y component of our position - which is the height or altitude. We add or subtract to change the zero position and then pass it into Smoothstep.\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -21553.0,
        "y": 899.0,
        "width": 200.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "18e321ef20d34f48bbebbe5ad8f58e69"
    }
}

