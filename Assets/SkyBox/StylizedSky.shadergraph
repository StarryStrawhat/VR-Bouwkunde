{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "b1b98b3b57a5406793b8f14db1cd76e1",
    "m_Title": "Normalize Node",
    "m_Content": "The Normalize Node changes the length or magnitude of a vector to unit length - so the length of the vector is 1.\n\nMany vector operations (dot product for example) require that input vectors all be the same length. The Normalize node can be used to ensure that this is the case.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -20293.0,
        "y": -259.0,
        "width": 200.0,
        "height": 184.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

