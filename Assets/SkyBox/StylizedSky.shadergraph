{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3b3ec3c6618c49c4ad38aed6baf93548",
    "m_Title": "",
    "m_Content": "Here we're using the Dot Product node to create a reflection vector.  This produces the same result as using the Reflection node.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -12819.0,
        "y": 835.0,
        "width": 200.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "59c7950050ed4b5b9d80702cfe59b3fb"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3b9eb4d9985c4b9882aa9c679e9730eb",
    "m_Title": "Range",
    "m_Content": "Usually, it works best if the T value is between zero and one. In this example, passing in a T value of zero would result in green. Passing in a T value of 1 would result in blue. Passing in a T value of 0.5 (shown here) results in the 50/50 blend between green and blue - cyan.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -15982.0,
        "y": 758.0,
        "width": 261.0,
        "height": 131.0
    },
    "m_Group": {
        "m_Id": "0f0394c9bbc940e4a4f957d7bf367b04"
    }
}

