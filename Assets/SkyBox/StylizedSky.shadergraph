{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6df820e3bf394d19b99bdf28c4df5d93",
    "m_Title": "Lerp Node",
    "m_Content": "The Lerp Node performs linear interpolation or linear blending between the input values A and B. \n\nThe point on the line between A and B is defined by input T where a T value of 0 will give only input A, a T value of 1 will give only input B, and a T value of 0.5 will give a blend result that's half way between A and B.\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -14915.0,
        "y": -294.0,
        "width": 322.0,
        "height": 136.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

