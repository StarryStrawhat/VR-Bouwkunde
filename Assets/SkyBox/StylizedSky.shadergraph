{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cd9fc02fa79f4d9386f0bb88f6382dbf",
    "m_Title": "",
    "m_Content": "You can use Position in World space to create texture coordinates.  A projected texture stays put in the world as objects move and rotate, so it can create some really interesting effects.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4926.0,
        "y": 841.0,
        "width": 200.0,
        "height": 115.0
    },
    "m_Group": {
        "m_Id": "3fe8c6de800d4c04a1bea862360c8271"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cda6649431f14e61be3beebd42426e4e",
    "m_Title": "Maximum Node",
    "m_Content": "The Maximum Node either gives you input A or input B - which ever is larger.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
