{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a06a2317e9f34089a3dcb03500809d8a",
    "m_Title": "",
    "m_Content": "the Dot Product node multiplies each of the components together and then adds up the result.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -12580.0,
        "y": -106.0,
        "width": 200.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "9ee310f5f84f4e2daa85be33180e764e"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a06f257c06f6455f822bd282222dcaad",
    "m_Title": "",
    "m_Content": "The Tile input is the frame number to display.  In this case it has a range of 0-15 because there are 4 rows and 4 columns for a total of 16 frames.\n\nIf we plug Time into the Tile input port, we can flip from one frame to the next - creating an animated effect.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -6196.0,
        "y": 2263.0,
        "width": 277.0,
        "height": 117.0
    },
    "m_Group": {
        "m_Id": "296a31cf2ca74688bf9958159a529269"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.PreviewNode",
    "m_ObjectId": "a0c5f12f9ef3461c8f934399ed0485d5",
    "m_Group": {
        "m_Id": "6143aca7418a46fa959744c58709d0e8"
    },
    "m_Name": "Preview",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -14809.0,
            "y": 124.0,
            "width": 208.0,
            "height": 278.0001525878906
        }
    },
    "m_Slots": [
        {
            "m_Id": "f942f67c8ff84588affb8bab65d50863"
        },
        {
            "m_Id": "59b98775a56144158ae527e3c7a88f3e"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
