    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0915e98b2b444af2b8496270fd31350b",
    "m_Title": "",
    "m_Content": "Dividing by zero returns a NaN or Not A Number. This can cause bad rendering artifacts and should be avoided. Avoiding this can sometimes be tricky because some nodes, such as Normalize, use divide internally.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -9289.0,
