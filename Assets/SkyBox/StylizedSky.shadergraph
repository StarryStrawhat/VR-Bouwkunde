{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4b9f215961af46df8b030f686e190b8e",
    "m_Title": "Multiply Node",
    "m_Content": "The Multiply Node is used to multiply two values together. Multiply is the most basic and commonly used operation. It can be used for Floats, Vectors, and Matrices.\n\nIf both inputs are a vector type, the output type will be a vector type with the same dimension as the evaluated type of those inputs. If both inputs are a matrix type, the output type will be a matrix type with the same dimension as the evaluated type of those inputs. If one input is a vector type and the other is a matrix type, then output type will be a vector with the same dimension as the vector type input.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -18560.0,
        "y": -264.0,
        "width": 381.0,
        "height": 169.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

