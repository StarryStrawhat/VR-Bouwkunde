{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6439f6764490435e89381cd3fb2032bd",
    "m_Title": "Saturation",
    "m_Content": "Here, we're bleding between a black and white and a color version of the same image. When our T value is zero, we get the black and white image.  When the T value is one, we get the color image.  When it's 0.5, we get a reduced or desaturated version of the image.  If we go above 1, we get an over saturated version of the image.  And if we go below zero, we get the inverted (or negative) color version of the image.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -14191.0,
        "y": 488.0,
        "width": 233.0,
        "height": 192.0
    },
    "m_Group": {
        "m_Id": "6840e2fe1793481eb30e8801dbd3e82f"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "64702e902f96456f88e9a3709fd97a7f",
    "m_Title": "",
    "m_Content": "The user can put a 1 in the channel they want to use.  This will isolate the channel they choose.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -11476.0,
        "y": 378.0,
        "width": 200.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "d63129b419fd492bb303202b59f5bda2"
    }
}

